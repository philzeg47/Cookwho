// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    repas         Repas[]
}

// Domaine métier CookWho — l'organisateur est l'utilisateur Auth.js (User).
model Repas {
    id             String   @id @default(cuid())
    organisateur   User     @relation(fields: [organisateurId], references: [id], onDelete: Cascade)
    organisateurId String
    lieu           String
    date           DateTime
    heure          String // format "HH:mm"
    createdAt      DateTime @default(now())
    expiresAt      DateTime // garde-fou RGPD (purge planifiée — story 2.5)

    participants Participant[]

    @@index([organisateurId])
}

enum StatutParticipant {
    EN_ATTENTE
    REPONDU
}

model Participant {
    id          String            @id @default(cuid())
    repas       Repas             @relation(fields: [repasId], references: [id], onDelete: Cascade)
    repasId     String
    prenom      String
    email       String?
    accessToken String            @unique // token 256 bits (crypto) — URL /p/{token}
    statut      StatutParticipant @default(EN_ATTENTE)
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt

    restrictions Restriction[]

    @@index([repasId])
}

enum TypeRestriction {
    REGIME
    ALLERGIE
    NON_AIME
}

// Restriction alimentaire déclarée par un participant (story 3.2).
// onDelete: Cascade — purge RGPD (story 2.5) : supprimer un Repas cascade
// jusqu'aux participants puis à leurs restrictions (données de santé, NFR6).
model Restriction {
    id             String          @id @default(cuid())
    participant    Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
    participantId  String
    type           TypeRestriction
    valeur         String
    seuilTolerance Int? // 0-5, seulement pour NON_AIME
    createdAt      DateTime        @default(now())

    @@index([participantId])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// Cache persistant des recettes récupérées via une SourceDeRecettes (story 4.2).
// Résilience : si la source casse, on resert le cache. Texte d'ingrédients BRUT
// (non normalisé) ; la normalisation/détection /core s'applique plus tard (4.4).
model RecetteCache {
    id               String   @id @default(cuid())
    source           String // ex. "marmiton"
    sourceRef        String // identifiant stable côté source (URL/slug)
    titre            String
    ingredientsTexte String[] // lignes d'ingrédients en texte libre
    fetchedAt        DateTime @default(now())

    @@unique([source, sourceRef])
    @@index([source])
}
